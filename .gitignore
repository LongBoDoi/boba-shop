# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# the built game
dist/

# native build output (the projects themselves are committed: android/, ios/)
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/app/src/main/assets/public/
ios/App/App/public/
ios/App/build/
ios/App/Pods/
ios/DerivedData/
*.xcuserdatastate
xcuserdata/

# signing material. The one key in the repository is deliberate and is excepted below: it signs
# the side-loaded .apk, and a key that stays the same is what lets a newer file install over an
# older one and keep the player's shop. See android/app/build.gradle.
*.jks
*.p8
*.p12
*.key
*.mobileprovision
!android/app/preview-signing.p12

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# a local copy of ffmpeg for tools/audio/build-foley.cjs
tools/audio/bin/

# scratch: screenshots and one-off scripts from driving the game in a browser
.expo/
